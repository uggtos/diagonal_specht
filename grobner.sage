# -*- python-indent-offset: 4; indent-tabs-mode: nil -*-
# ================================================================
# grobner.sage
#
# Exact SageMath verification of Lemma 5.14.
#
# The program checks:
#
# (1) For 1 <= l <= 3,
#
#       I(V_(1,1,1)) = <B^(l)>
#
#     where I(V_(1,1,1)) is computed as
#
#       I_12 intersection I_13 intersection I_23.
#
# (2) For 1 <= l <= 6, every S-polynomial of two elements of B^(l)
#     reduces to zero modulo B^(l).
#
# The polynomial-ring order is the order of Definition 5.9.
# ================================================================


from itertools import combinations
from sage.rings.polynomial.term_order import TermOrder


# ================================================================
# Polynomial rings and the monomial order
# ================================================================

def diagonal_ring(m, n):
    r"""
    Return (R, x, pos), where

        R = QQ[x_{r,i} : 1 <= r <= m, 1 <= i <= n].

    The variables are listed in the order

        x_{1,n}, ..., x_{m,n},
        x_{1,n-1}, ..., x_{m,n-1},
        ...
        x_{1,1}, ..., x_{m,1}.

    The monomial order is the block order

        [column n] > [column n-1] > ... > [column 1],

    with degree-reverse-lexicographic order inside each block and

        x_{1,i} > x_{2,i} > ... > x_{m,i}.
    """
    names = []
    pos = {}
    counter = 0

    # The variables in column n are listed first.
    for i in range(n, 0, -1):
        for r in range(m):
            names.append("x_%s_%s" % (r + 1, i))
            pos[(r, i)] = counter
            counter += 1

    order = TermOrder("degrevlex", m)

    for j in range(n - 1):
        order = order + TermOrder("degrevlex", m)

    R = PolynomialRing(QQ, names=names, order=order)
    variables = R.gens()

    # x[r][i] represents x_{r+1,i}.
    x = [[None for i in range(n + 1)] for r in range(m)]

    for r in range(m):
        for i in range(1, n + 1):
            x[r][i] = variables[pos[(r, i)]]

    return R, x, pos


# ================================================================
# Symmetric-group action
# ================================================================

def monomial_from_exponents(R, exponents):
    """
    Construct a monomial from its exponent vector.
    """
    result = R.one()

    for variable, exponent in zip(R.gens(), exponents):
        if exponent != 0:
            result *= variable**exponent

    return result


def act_on_monomial(mon, permutation, R, m, n, pos):
    r"""
    Apply a permutation to a monomial according to

        permutation . x_{r,i} = x_{r,permutation(i)}.
    """
    old_exponents = mon.exponents()[0]
    new_exponents = [0 for j in range(R.ngens())]

    for r in range(m):
        for i in range(1, n + 1):
            old_position = pos[(r, i)]
            new_position = pos[(r, permutation(i))]
            new_exponents[new_position] = old_exponents[old_position]

    return monomial_from_exponents(R, new_exponents)


def alternating_polynomial(mon, R, m, n, pos):
    r"""
    Compute

        sum_{sigma in S_n} sign(sigma) sigma.mon.
    """
    result = R.zero()

    for permutation in SymmetricGroup(n):
        result += (
            permutation.sign()
            * act_on_monomial(mon, permutation, R, m, n, pos)
        )

    return result


# ================================================================
# The generators B^(l)
# ================================================================

def B_for_111(l):
    r"""
    Construct the set B^(l) from Lemma 5.13 in R_{l,3}.
    """
    R, x, pos = diagonal_ring(l, 3)
    B = []

    # The quadratic generators
    #
    #   q_{r,s} = epsilon_A(x_{s,2} x_{r,3}),   r < s.
    #
    for r in range(l):
        for s in range(r + 1, l):
            B.append(
                alternating_polynomial(
                    x[s][2] * x[r][3],
                    R,
                    l,
                    3,
                    pos
                )
            )

    # The cubic generators
    #
    #   p_{r,12} p_{s,13} p_{t,23},   r <= s <= t,
    #
    # where p_{r,ij} = x_{r,i} - x_{r,j}.
    for r in range(l):
        for s in range(r, l):
            for t in range(s, l):
                p_r_12 = x[r][1] - x[r][2]
                p_s_13 = x[s][1] - x[s][3]
                p_t_23 = x[t][2] - x[t][3]

                B.append(p_r_12 * p_s_13 * p_t_23)

    return R, x, pos, B


# ================================================================
# The ideal I(V_(1,1,1))
# ================================================================

def vanishing_ideal_111(l):
    r"""
    Compute I(V_(1,1,1)) in R_{l,3} as

        I_12 intersection I_13 intersection I_23,

    where I_ij is generated by all x_{r,i} - x_{r,j}.
    """
    R, x, pos = diagonal_ring(l, 3)

    I12 = R.ideal([
        x[r][1] - x[r][2]
        for r in range(l)
    ])

    I13 = R.ideal([
        x[r][1] - x[r][3]
        for r in range(l)
    ])

    I23 = R.ideal([
        x[r][2] - x[r][3]
        for r in range(l)
    ])

    intersection = I12.intersection(I13).intersection(I23)

    # Return the ideal generated by a Groebner basis of the intersection.
    return R.ideal(intersection.groebner_basis())


# ================================================================
# Ideal comparison
# ================================================================

def normal_form(f, generators):
    """
    Reduce f by the ordered list of generators.
    """
    return f.reduce(generators)


def ideals_are_equal(I, J):
    """
    Test equality of two ideals by reducing Groebner-basis elements
    of each ideal by a Groebner basis of the other ideal.
    """
    GI = list(I.groebner_basis())
    GJ = list(J.groebner_basis())

    return (
        all(normal_form(f, GJ) == 0 for f in GI)
        and
        all(normal_form(g, GI) == 0 for g in GJ)
    )


# ================================================================
# S-polynomials
# ================================================================

def monomial_lcm(a, b, R):
    """
    Compute the least common multiple of two monomials.
    """
    exponent_a = a.exponents()[0]
    exponent_b = b.exponents()[0]

    exponent_lcm = [
        max(exponent_a[i], exponent_b[i])
        for i in range(len(exponent_a))
    ]

    return monomial_from_exponents(R, exponent_lcm)


def monomial_quotient(a, b, R):
    """
    Compute a/b, assuming that b divides a.
    """
    exponent_a = a.exponents()[0]
    exponent_b = b.exponents()[0]

    assert all(
        exponent_a[i] >= exponent_b[i]
        for i in range(len(exponent_a))
    )

    exponent_quotient = [
        exponent_a[i] - exponent_b[i]
        for i in range(len(exponent_a))
    ]

    return monomial_from_exponents(R, exponent_quotient)


def s_polynomial(f, g, R):
    r"""
    Compute the standard S-polynomial

        lcm(LM(f),LM(g))/LT(f) * f
        -
        lcm(LM(f),LM(g))/LT(g) * g.
    """
    lm_f = f.leading_monomial()
    lm_g = g.leading_monomial()

    lc_f = f.leading_coefficient()
    lc_g = g.leading_coefficient()

    lcm_fg = monomial_lcm(lm_f, lm_g, R)

    multiplier_f = monomial_quotient(lcm_fg, lm_f, R) / lc_f
    multiplier_g = monomial_quotient(lcm_fg, lm_g, R) / lc_g

    return multiplier_f * f - multiplier_g * g


# ================================================================
# Verification of Lemma 5.14
# ================================================================

def verify_lemma_514():
    print("")
    print("======================================================")
    print("Verification of Lemma 5.14")
    print("======================================================")

    # ------------------------------------------------------------
    # Lemma 5.14(1)
    # ------------------------------------------------------------

    print("")
    print("Checking Lemma 5.14(1):")

    for l in range(1, 4):
        R, x, pos, B = B_for_111(l)

        I_V = vanishing_ideal_111(l)
        ideal_generated_by_B = R.ideal(B)

        assert ideals_are_equal(I_V, ideal_generated_by_B), \
            "Lemma 5.14(1) fails for l = %s." % l

        print("  Verified for l = %s." % l)

    # ------------------------------------------------------------
    # Lemma 5.14(2)
    # ------------------------------------------------------------

    print("")
    print("Checking Lemma 5.14(2):")

    for l in range(1, 7):
        R, x, pos, B = B_for_111(l)

        number_of_pairs = 0

        for f, g in combinations(B, 2):
            number_of_pairs += 1

            S = s_polynomial(f, g, R)
            remainder = normal_form(S, B)

            assert remainder == 0, \
                "Lemma 5.14(2) fails for l = %s." % l

        print(
            "  Verified for l = %s: "
            "%s S-polynomials reduce to zero."
            % (l, number_of_pairs)
        )

    print("")
    print("All checks in Lemma 5.14 passed.")


# ================================================================
# Run the verification
# ================================================================

if __name__ == "__main__":
    verify_lemma_514()